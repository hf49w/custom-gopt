REPO_URL="https://github.com/hf49w/custom-gopt.git"
REPO_DIR="${HOME}/work/custom-gopt"
VENV_DIR="${HOME}/venvs/custom-gopt"

SERVER_USER="your_user"
SERVER_HOST="your.server.host"
SERVER_PORT="22"

LOCAL_DATASET_ROOT="/path/to/local/speechocean762/speechocean762"
LOCAL_WHISPER_BASE_MODEL_DIR="/path/to/local_assets/whisper-base"
# LOCAL_ALIGNER_MODEL_DIR="/path/to/local_assets/charsiu-en-w2v2-tiny-fc-10ms"

SERVER_DATA_ROOT="${HOME}/data/custom-gopt"
DATA_ROOT="${SERVER_DATA_ROOT}"
DATASET_ROOT="${SERVER_DATA_ROOT}/speechocean762/speechocean762"
WHISPER_BASE_MODEL_DIR="${SERVER_DATA_ROOT}/models/whisper-base"

# Optional: upload and point this to a local Charsiu checkpoint directory.
ALIGNER_MODEL="charsiu/en_w2v2_tiny_fc_10ms"
# ALIGNER_MODEL_DIR="${SERVER_DATA_ROOT}/models/charsiu-en-w2v2-tiny-fc-10ms"

HF_HOME="${SERVER_DATA_ROOT}/hf_cache"
TRANSFORMERS_CACHE="${HF_HOME}/transformers"
HF_HUB_CACHE="${HF_HOME}/hub"

LANGUAGE="english"
TIMESTAMP_BACKEND="transformers"
CHUNK_SEC="0.64"
RIGHT_CONTEXT_SEC="0.16"
MIN_UTT_MATCH_RATIO="0.5"

WHISPER_BATCH_SIZE="8"
WHISPER_EVAL_BATCH_SIZE="8"
WHISPER_EPOCHS="8"

GOPT_BATCH_SIZE="25"
GOPT_EPOCHS="100"
GOPT_DEPTH="3"
GOPT_HEADS="1"
GOPT_EMBED_DIM="24"
GOPT_MAIN_CONTEXT_TOKENS="4,8,12,16"
GOPT_RIGHT_CONTEXT_TOKENS="0,1,2,4"

# Example GPU wheel index for CUDA 12.1.
TORCH_WHEEL_INDEX_URL="https://download.pytorch.org/whl/cu121"
