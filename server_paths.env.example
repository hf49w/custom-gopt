REPO_URL="https://github.com/hf49w/custom-gopt.git"
REPO_DIR="${HOME}/work/custom-gopt"
ENV_MANAGER="conda"
CONDA_ENV_PREFIX="${REPO_DIR}/.conda_env"
VENV_DIR="${HOME}/venvs/custom-gopt"
PYTHON_VERSION="3.10"

SERVER_USER="your_user"
SERVER_HOST="your.server.host"
SERVER_PORT="22"

LOCAL_DATASET_ROOT="/path/to/local/speechocean762/speechocean762"
LOCAL_WHISPER_BASE_MODEL_DIR="/path/to/local_assets/whisper-base"
LOCAL_CHARSIU_SRC_DIR="/path/to/local_assets/charsiu_repo"
LOCAL_ALIGNER_MODEL_DIR="/path/to/local_assets/charsiu_en_w2v2_tiny_fc_10ms"

SERVER_DATA_ROOT="${HOME}/data/custom-gopt"
DATA_ROOT="${SERVER_DATA_ROOT}"
DATASET_ROOT="${SERVER_DATA_ROOT}/speechocean762/speechocean762"
WHISPER_BASE_MODEL_DIR="${SERVER_DATA_ROOT}/models/whisper-base"

# Optional: upload and point this to a local Charsiu checkpoint directory.
ALIGNER_MODEL="charsiu/en_w2v2_tiny_fc_10ms"
ALIGNER_MODEL_DIR="${SERVER_DATA_ROOT}/models/charsiu_en_w2v2_tiny_fc_10ms"
CHARSIU_SRC_DIR="${SERVER_DATA_ROOT}/src/charsiu_repo"

HF_HOME="${SERVER_DATA_ROOT}/hf_cache"
TRANSFORMERS_CACHE="${HF_HOME}/transformers"
HF_HUB_CACHE="${HF_HOME}/hub"
TMPDIR="${SERVER_DATA_ROOT}/tmp"
PIP_CACHE_DIR="${SERVER_DATA_ROOT}/pip_cache"
CONDA_PKGS_DIRS="${SERVER_DATA_ROOT}/conda_pkgs"

# Prefer isolating one physical GPU. Example: only expose GPU 7 and let the code use visible cuda:0.
CUDA_VISIBLE_DEVICES="0,1,2,3"
TRAIN_DEVICE="cuda"
GOPT_DATA_MULTI_GPU="1"
GOPT_DATA_GPU_IDS="0,1,2,3"
GOPT_DATA_FINALIZE_DEVICE="cpu"

LANGUAGE="english"
TIMESTAMP_BACKEND="transformers"
CHUNK_SEC="0.64"
RIGHT_CONTEXT_SEC="0.16"
MIN_UTT_MATCH_RATIO="0.5"
VAL_SPEAKER_RATIO="0.5"
SPLIT_SEED="1337"
ASR_BATCH_SIZE="4"
ASR_MIN_BATCH_SIZE="1"
ASR_MAX_NEW_TOKENS="128"
ASR_TORCH_DTYPE="auto"
ASR_USE_CACHE="0"
ASR_EMPTY_CACHE="1"
PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"

WHISPER_BATCH_SIZE="16"
WHISPER_EVAL_BATCH_SIZE="16"
WHISPER_EPOCHS="8"
WHISPER_NUM_WORKERS="8"
WHISPER_EVAL_GENERATE_MAX_SAMPLES="256"
WHISPER_COMPILE="1"
WHISPER_TF32="1"

GOPT_BATCH_SIZE="64"
GOPT_EPOCHS="100"
GOPT_DEPTH="3"
GOPT_HEADS="1"
GOPT_EMBED_DIM="24"
GOPT_MAIN_CONTEXT_TOKENS="4,8,12,16"
GOPT_RIGHT_CONTEXT_TOKENS="0,1,2,4"
GOPT_NUM_WORKERS="8"
GOPT_COMPILE="1"
GOPT_TF32="1"

# Example GPU wheel index for CUDA 12.1.
TORCH_WHEEL_INDEX_URL="https://download.pytorch.org/whl/cu121"
